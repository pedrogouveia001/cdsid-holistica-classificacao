      object txtimpAD: TIWText
        Left = 16
        Top = 59
        Width = 481
        Height = 301
        Cursor = crAuto
        IW50Hint = False
        ParentShowHint = False
        ShowHint = True
        ZIndex = 0
        RenderSize = True
        StyleRenderOptions.RenderSize = True
        StyleRenderOptions.RenderPosition = True
        StyleRenderOptions.RenderFont = True
        StyleRenderOptions.RenderZIndex = True
        StyleRenderOptions.RenderVisibility = True
        StyleRenderOptions.RenderStatus = True
        StyleRenderOptions.RenderAbsolute = True
        BGColor = clNone
        ConvertSpaces = False
        Font.Color = clNone
        Font.FontName = 'Verdana'
        Font.FontFamily = 'Verdana, Helvetica, Sans-Serif'
        Font.Size = 9
        Font.Style = []
        FriendlyName = 'txtimpAD'
        Lines.Strings = (
          
            '-> In order to construct the discrete criterion scale, you shoul' +
            'd consider a Likert scale;'
          ''
          
            '-> The scale must contain a maximum of n = 7 and a minimum of n ' +
            '= 2 levels;'
          ''
          
            '-> For 2-level discrete criteria, you must adopt a scale with co' +
            'nsequeces 0 or 1;'
          ''
          
            '-> For n-level discrete criteria, the scale adopted must contain' +
            ' values between 1 and n;'
          ''
          
            '-> In cases in which it is not possible to evaluate the alternat' +
            'ives using this kind of scale (maximun of 7 levels), you shall c' +
            'onsider the criterion as a continuous one.'
          ''
          
            '-> For the 2-level discrete criteria, a consequence with a value' +
            ' of 0 does not necessarily indicate the absence of ownership, bu' +
            't only that the alternative was less well evaluated'
          ''
          'For more information about discrete criteria see the user guide.')
        RawText = False
        UseFrame = False
        WantReturns = True
      end
