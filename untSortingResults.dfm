        Font.FontFamily = 'Verdana, Helvetica, Sans-Serif'
        Font.Size = 8
        Font.Style = []
        FriendlyName = 'IWText4'
        Lines.Strings = (
          
            'From the study of the discrete probability distributions, it was' +
            ' observed that the hit probability for such a decision process f' +
            'ollows a Bernoulli distribution. Thus, based on this distributio' +
            'n, the standard deviation  was calculated for a general case whe' +
            're the hit probability in a range of 0 to 1 were considered, all' +
            'owing to obtain the standard deviation values pi function.')
        RawText = False
        UseFrame = False
        WantReturns = True
      end
